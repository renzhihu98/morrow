# Morrow — copy to apps/web/.env.local. With none of these set, the app runs in demo mode on fixtures.

# LLM via Vercel AI Gateway (or use Vercel OIDC when deployed)
AI_GATEWAY_API_KEY=

# Postgres (Neon). Unset → in-memory fixture repository
DATABASE_URL=

# Protects /api/cron/dawn and /api/cron/verify
CRON_SECRET=

# Google Calendar + Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify Web API OAuth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 32-byte key (base64) for encrypting stored OAuth tokens
TOKEN_ENCRYPTION_KEY=

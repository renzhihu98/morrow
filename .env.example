# Morrow — local env lives in apps/web/.env.local, normally pulled with:
#   vercel env pull apps/web/.env.local
# With DATABASE_URL unset the web app runs in demo mode on fixtures (no auth, scripted Morrow).
# Never commit real values.

# ── Database (Vercel Marketplace → Neon) ───────────────────────────────────
# Set → auth + real data (Better Auth, Drizzle). Unset → demo mode.
DATABASE_URL=

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32. Also encrypts stored OAuth tokens.
BETTER_AUTH_SECRET=
# Locally http://127.0.0.1:3000 (Spotify rejects localhost redirect URIs); the production URL when deployed.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Google Cloud Console OAuth client (sign-in + Calendar).
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify Developer Dashboard app.
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── AI (Vercel AI Gateway) ─────────────────────────────────────────────────
# Either works; VERCEL_OIDC_TOKEN comes from `vercel env pull` locally and is automatic on Vercel.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# ── Jobs ───────────────────────────────────────────────────────────────────
# Protects /api/cron/{sync,dawn,verify} (Authorization: Bearer <secret>).
CRON_SECRET=

# ── Mobile (apps/mobile) ───────────────────────────────────────────────────
# Web API base URL for the Expo app (http://<LAN IP>:3000 on a device).
EXPO_PUBLIC_API_URL=
